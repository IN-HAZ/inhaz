APP_NAME=inHaz
APP_ENV=local
APP_KEY=base64:FwL6vm+ohcWmePD0O40+/+Yy4lDB+OkSQJtDth1IJGI=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=inhaz
DB_USERNAME=inhaz
DB_PASSWORD=inhaz

# Redis / Cache / Session / Queue
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
CORS_ALLOWED_ORIGINS_PATTERNS='#^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+)(:\d+)?$#'

# Mail (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@inhaz.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage (RustFS / S3-compatible)
AWS_ACCESS_KEY_ID=inhaz
AWS_SECRET_ACCESS_KEY=inhazsecretkey
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=inhaz-bucket
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Maps
GOOGLE_MAPS_SERVER_API_KEY=<api_key>
