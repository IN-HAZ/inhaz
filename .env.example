# Root env for production: cp .env.example .env (at repo root), then fill in.
# Run with: make prod-up  (or from repo root:
#   docker compose --env-file .env -f infra/docker-compose.prod.yml up -d)
# Loaded by infra/docker-compose.prod.yml via env_file for every service.

APP_NAME=inHaz
APP_ENV=production
APP_DEBUG=false
# Required, no default. Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=inhaz
DB_USERNAME=inhaz
# Required
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
# Required; compose refuses to start without it (fail-fast requirepass)
REDIS_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Comma-separated list of origins allowed to call the API.
# Do NOT set CORS_ALLOWED_ORIGINS_PATTERNS in production unless you mean it.
CORS_ALLOWED_ORIGINS=https://app.example.com

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@inhaz.com"
MAIL_FROM_NAME="${APP_NAME}"
