# ==============================================================================
# inHaz Monorepo Unified Environment Configuration Template
# Copy this file to .env at the root of the repository: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION (Laravel)
# ------------------------------------------------------------------------------
APP_NAME=inHaz
APP_ENV=local
# Required in production. Generate with: php artisan key:generate --show
APP_KEY=base64:FwL6vm+ohcWmePD0O40+/+Yy4lDB+OkSQJtDth1IJGI=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=inhaz
DB_USERNAME=inhaz
DB_PASSWORD=inhaz

# ------------------------------------------------------------------------------
# REDIS, CACHE, SESSION & QUEUE
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Required for production redis container fail-fast check. Keep empty for dev.
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------------------
# SECURITY & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
CORS_ALLOWED_ORIGINS_PATTERNS='#^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+)(:\d+)?$#'

# ------------------------------------------------------------------------------
# MAIL CONFIGURATION (Mailpit in Dev)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@inhaz.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# AWS S3 / RUSTFS CONFIGURATION
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=inhaz
AWS_SECRET_ACCESS_KEY=inhazsecretkey
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=inhaz-bucket
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
# MOBILE APP CONFIGURATION (React Native / Expo)
# Target API URL used by Expo client to communicate with Laravel REST API
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
